# RSA21-Free – .gitignore

# Config (auto-generated by installer)
/config.php

# Uploads and storage (keep dirs via .gitkeep)
/uploads/*
!/uploads/.gitkeep
!/uploads/.tmp/

# Backups
/backups/*
!/backups/.gitkeep

# Logs
/infos/*
!/infos/.gitkeep

# Storage
/storage/**/*
!/storage/symbols/.gitkeep
!/storage/templates/.gitkeep

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# PHP
*.log

# Temp
/tmp/
