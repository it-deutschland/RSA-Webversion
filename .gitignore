# RSA21-Free – .gitignore

# Config (auto-generated by installer)
/config.php

# Uploads and storage (keep dirs via .gitkeep)
/dateien/*
!/dateien/.gitkeep
!/dateien/.tmp/

# Backups
/sicherungen/*
!/sicherungen/.gitkeep

# Logs
/infos/*
!/infos/.gitkeep

# Storage
/speicher/**/*
!/speicher/symbols/.gitkeep
!/speicher/templates/.gitkeep

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# PHP
*.log

# Temp
/tmp/
